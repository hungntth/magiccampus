PORT=4000
MONGO_URI=mongodb://127.0.0.1:27018/mcgame
# Folder holding the md5-named asset blobs (the old frontend/s/res cache)
ASSET_DIR=D:/mcgame/frontend/s/res
# Folder holding the old Postgres seed dumps (used by `pnpm import:seeds`)
SEED_DIR=D:/mcgame/supabase/seeds
CORS_ORIGIN=http://localhost:5173

# Local dev test account for HUD checks (created on a local DB only).
# DEV_TEST_USER=hudtest
# DEV_TEST_PASS=hudtest123
# Second local test account (spectate / gate checks, M9; driven by a scripted ws bot).
# DEV_TEST_USER2=watchbot
# DEV_TEST_PASS2=watchbot123
# Third local test account (3-member phụ bản runs, M10 phase C; char "LangBot").
# DEV_TEST_USER3=lhbot
# DEV_TEST_PASS3=lhbot123

# Dev/GM chat commands (/go, /buff, /grant). Off by default: only accounts with gmLevel > 0 may use them.
# Set to 1 on a local dev server to open them to every account.
# DEV_COMMANDS=1
