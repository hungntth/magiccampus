{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "paths": {
      "@mc/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
